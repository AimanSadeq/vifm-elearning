# ============================================
# SUPABASE
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# APP
# ============================================
NEXT_PUBLIC_APP_URL=https://learn.vifm.org
NEXT_PUBLIC_APP_NAME=VIFM Academy
NODE_ENV=production

# ============================================
# STRIPE
# ============================================
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================
# PAYTABS
# ============================================
PAYTABS_SERVER_KEY=your-paytabs-server-key
PAYTABS_PROFILE_ID=your-profile-id
PAYTABS_REGION=ARE

# ============================================
# MAMOPAY
# ============================================
# sandbox | production
MAMOPAY_ENV=sandbox
MAMOPAY_API_KEY=your-mamopay-bearer-token
MAMOPAY_WEBHOOK_SECRET=your-mamopay-webhook-hmac-secret

# ============================================
# ZOOM
# ============================================
ZOOM_ACCOUNT_ID=your-account-id
ZOOM_CLIENT_ID=your-client-id
ZOOM_CLIENT_SECRET=your-client-secret
ZOOM_WEBHOOK_SECRET_TOKEN=your-webhook-secret

# ============================================
# EMAIL (Resend)
# ============================================
RESEND_API_KEY=re_...
EMAIL_FROM=learn@vifm.org

# ============================================
# WHATSAPP (Twilio)
# ============================================
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_WHATSAPP_NUMBER=+14155238886

# ============================================
# AI RECOMMENDATIONS
# ============================================
ANTHROPIC_API_KEY=sk-ant-...
# OR
OPENAI_API_KEY=sk-...

# ============================================
# GOOGLE ANALYTICS
# ============================================
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================
# CRON / BANK / RATE LIMIT
# ============================================
# HMAC secret used by the designation-status cron route to authenticate
# scheduled invocations.
CRON_SECRET=your-cron-secret

# Shown to learners on the bank-transfer checkout page.
BANK_IBAN=AE...
BANK_SWIFT=...

# Distributed rate limiting. When set, applyRateLimit() uses Upstash Redis
# instead of the in-process Map (required for >1 instance / serverless).
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
