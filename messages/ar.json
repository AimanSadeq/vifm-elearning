  "privacyPolicy": {
    "title": "سياسة الخصوصية",
    "lastUpdated": "آخر تحديث: فبراير 2026",
    "introTitle": "مقدمة",
    "introText": "يلتزم معهد فرجينيا للمالية والإدارة (\"VIFM\" أو \"نحن\") بحماية خصوصيتك. توضح سياسة الخصوصية هذه كيفية جمع معلوماتك واستخدامها والإفصاح عنها وحمايتها عند استخدام منصة التعلم الإلكتروني الخاصة بنا.",
    "collectTitle": "المعلومات التي نجمعها",
    "collectText": "نجمع المعلومات التي تقدمها مباشرة، بما في ذلك اسمك وبريدك الإلكتروني ورقم هاتفك وتفاصيل مؤسستك ومعلومات الدفع عند تسجيل حساب أو التسجيل في الدورات أو التواصل معنا. كما نجمع تلقائياً بيانات الاستخدام مثل الصفحات التي تمت زيارتها والدورات التي تم الوصول إليها وتقدم مشاهدة الفيديو ومعلومات الجهاز.",
    "useTitle": "كيف نستخدم معلوماتك",
    "useText": "نستخدم المعلومات التي نجمعها لتقديم خدمات التعلم الإلكتروني وصيانتها، ومعالجة التسجيلات والمدفوعات، وتتبع تقدمك التعليمي وإصدار الشهادات، وإرسال تحديثات الدورات والإشعارات ذات الصلة، وتحسين منصتنا وتطوير ميزات جديدة، والامتثال للالتزامات القانونية.",
    "shareTitle": "مشاركة المعلومات",
    "shareText": "لا نبيع معلوماتك الشخصية. قد نشارك بياناتك مع المدربين (تقتصر على المعلومات المتعلقة بالدورة)، ومسؤولي المؤسسات (إذا كنت مسجلاً من خلال مؤسسة)، ومعالجي الدفع لإتمام المعاملات، ومقدمي الخدمات الذين يساعدون في تشغيل منصتنا.",
    "securityTitle": "أمن البيانات",
    "securityText": "ننفذ إجراءات أمنية وفقاً لمعايير الصناعة لحماية معلوماتك الشخصية، بما في ذلك تشفير البيانات أثناء النقل والتخزين، وآليات المصادقة الآمنة، وعمليات التدقيق الأمني المنتظمة.",
    "cookiesTitle": "ملفات تعريف الارتباط",
    "cookiesText": "نستخدم ملفات تعريف الارتباط والتقنيات المماثلة للحفاظ على جلستك وتذكر تفضيلاتك وتحليل استخدام المنصة. يمكنك التحكم في إعدادات ملفات تعريف الارتباط من خلال تفضيلات المتصفح.",
    "rightsTitle": "حقوقك",
    "rightsText": "لديك الحق في الوصول إلى معلوماتك الشخصية أو تصحيحها أو حذفها. يمكنك أيضاً طلب نسخة من بياناتك أو سحب الموافقة على أنشطة معالجة معينة. لممارسة هذه الحقوق، يرجى التواصل معنا.",
    "contactTitle": "اتصل بنا",
    "contactText": "إذا كانت لديك أسئلة حول سياسة الخصوصية هذه، يرجى التواصل معنا على privacy@vifm.edu أو من خلال صفحة الاتصال."
  },
  "termsOfService": {
    "title": "شروط الخدمة",
    "lastUpdated": "آخر تحديث: فبراير 2026",
    "introTitle": "الموافقة على الشروط",
    "introText": "باستخدام منصة التعلم الإلكتروني لأكاديمية VIFM أو الوصول إليها، فإنك توافق على الالتزام بشروط الخدمة هذه. إذا كنت لا توافق على هذه الشروط، يرجى عدم استخدام خدماتنا.",
    "accountTitle": "حسابات المستخدمين",
    "accountText": "يجب عليك تقديم معلومات دقيقة وكاملة عند إنشاء حساب. أنت مسؤول عن الحفاظ على سرية بيانات اعتمادك وعن جميع الأنشطة التي تتم تحت حسابك. يجب عليك إخطارنا فوراً بأي استخدام غير مصرح به.",
    "enrollmentTitle": "التسجيل في الدورات والوصول",
    "enrollmentText": "يتم منح الوصول إلى الدورة عند التسجيل الناجح والدفع (إن وجد). تعتمد مدة الوصول على الدورة أو خطة الاشتراك المشتراة. نحتفظ بالحق في تعديل محتوى الدورة لإبقائها محدثة وذات صلة.",
    "paymentTitle": "المدفوعات والاسترداد",
    "paymentText": "تُعرض جميع الأسعار بالعملة المطبقة. تتم معالجة المدفوعات بشكل آمن من خلال شركائنا في الدفع. يجب تقديم طلبات الاسترداد خلال 14 يوماً من التسجيل إذا تم الوصول إلى أقل من 25% من الدورة. يسري إلغاء الاشتراك في نهاية فترة الفوترة الحالية.",
    "contentTitle": "الملكية الفكرية",
    "contentText": "جميع محتويات الدورات والمواد ومقاطع الفيديو وميزات المنصة هي ملكية فكرية لـ VIFM أو مرخصيها. لا يجوز لك إعادة إنتاج أو توزيع أو تعديل أو إنشاء أعمال مشتقة من أي محتوى دون إذن كتابي صريح.",
    "conductTitle": "سلوك المستخدم",
    "conductText": "أنت توافق على عدم مشاركة بيانات اعتماد حسابك، أو إعادة توزيع مواد الدورة، أو استخدام أدوات آلية للوصول إلى المحتوى أو تنزيله، أو الانخراط في أي نشاط يعطل المنصة، أو نشر محتوى غير لائق في منتديات النقاش.",
    "certificatesTitle": "الشهادات",
    "certificatesText": "تُصدر الشهادات عند إكمال متطلبات الدورة بنجاح، بما في ذلك التقييمات حيثما ينطبق ذلك. تحتفظ VIFM بالحق في إلغاء الشهادات التي تم الحصول عليها بطرق احتيالية.",
    "corporateTitle": "الحسابات المؤسسية",
    "corporateText": "المؤسسات ذات الحسابات المؤسسية مسؤولة عن إدارة وصول موظفيها وضمان الامتثال لهذه الشروط. تخضع شروط الترخيص المؤسسي للاتفاقية المؤسسية المنفصلة.",
    "disclaimerTitle": "إخلاء المسؤولية",
    "disclaimerText": "يتم تقديم منصتنا ومحتواها \"كما هي\" دون ضمانات من أي نوع. على الرغم من سعينا للدقة، لا نضمن أن محتوى الدورة خالٍ من الأخطاء أو أن المنصة ستعمل دون انقطاع.",
    "liabilityTitle": "تحديد المسؤولية",
    "liabilityText": "لن تكون VIFM مسؤولة عن أي أضرار غير مباشرة أو عرضية أو تبعية ناشئة عن استخدامك للمنصة. لن تتجاوز مسؤوليتنا الإجمالية المبلغ الذي دفعته في الأشهر الاثني عشر السابقة للمطالبة.",
    "changesTitle": "تغييرات الشروط",
    "changesText": "قد نقوم بتحديث هذه الشروط من وقت لآخر. يعتبر استمرار استخدام المنصة بعد التغييرات قبولاً للشروط المحدثة. سنقوم بإخطار المستخدمين المسجلين بالتغييرات الهامة عبر البريد الإلكتروني.",
    "contactTitle": "اتصل بنا",
